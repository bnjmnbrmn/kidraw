server {
    server_name kidraw.dev.bnjmnbrmn.com;

    location = /homepage {
        return 308 /homepage/;
    }

    # Static preview of the kidraw.net introduction page. The page is a
    # self-contained index.html generated by site/build.mjs.
    location /homepage/ {
        alias /var/www/kidraw-homepage/;
        index index.html;
        autoindex off;
        add_header Cache-Control "no-cache";
    }

    location /shots/ {
        alias /var/www/kidraw-shots/;
        autoindex on;
        add_header Cache-Control "no-cache";
    }

    location = /debug-log {
        proxy_pass http://127.0.0.1:9222/;
    }

    # Sub-endpoints of the log collector (e.g. /debug-log/draft -> /draft,
    # the draft mirror written to tools/draft-mirror.json).
    location /debug-log/ {
        proxy_pass http://127.0.0.1:9222/;
    }

    location / {
        proxy_pass http://localhost:4200;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    listen 443 ssl; # managed by Certbot
    ssl_certificate /etc/letsencrypt/live/kidraw.dev.bnjmnbrmn.com/fullchain.pem; # managed by Certbot
    ssl_certificate_key /etc/letsencrypt/live/kidraw.dev.bnjmnbrmn.com/privkey.pem; # managed by Certbot
    include /etc/letsencrypt/options-ssl-nginx.conf; # managed by Certbot
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem; # managed by Certbot
}

server {
    if ($host = kidraw.dev.bnjmnbrmn.com) {
        return 301 https://$host$request_uri;
    } # managed by Certbot

    listen 80;
    server_name kidraw.dev.bnjmnbrmn.com;
    return 404; # managed by Certbot
}
